{
  "schemaVersion": 1,
  "language": "go",
  "status": "qualified",
  "supportSlice": "go-v0.25-target-runtime-small-programs",
  "nativeRuntime": "verified separately by tests/language_completion/manifests/go_native.json and npm run language:go:bidirectional",
  "targets": ["lua", "javascript", "luascript", "python", "csharp"],
  "fixtures": [
    {
      "name": "arithmetic_functions",
      "sourceLanguage": "go",
      "source": "tests/language_completion/fixtures/go/arithmetic_functions.go",
