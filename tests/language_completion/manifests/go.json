      "skipNative": true,
      "expectedOutput": "go_control ready 5"
    },
    {
      "name": "array_range_len",
      "sourceLanguage": "go",
      "source": "tests/language_completion/fixtures/go/array_range_len.go",
      "skipNative": true,
      "expectedOutput": "go_array 10 4"
    },
    {
      "name": "numeric_for_break_continue",
      "sourceLanguage": "go",
      "source": "tests/language_completion/fixtures/go/numeric_for_break_continue.go",
      "skipNative": true,
      "expectedOutput": "go_loop 13"
    },
    {
      "name": "struct_fields",
      "sourceLanguage": "go",
