      "expectedOutput": "c_while 6"
    },
    {
      "name": "numeric_for",
      "source": "tests/language_completion/fixtures/c/numeric_for.c",
      "expectedOutput": "c_for 10"
    },
    {
      "name": "array_indexing",
      "source": "tests/language_completion/fixtures/c/array_indexing.c",
      "expectedOutput": "c_array 8 4"
    },
    {
      "name": "boolean_logic",
      "source": "tests/language_completion/fixtures/c/boolean_logic.c",
      "expectedOutput": "c_bool ready"
    },
    {
      "name": "break_continue",
      "source": "tests/language_completion/fixtures/c/break_continue.c",
