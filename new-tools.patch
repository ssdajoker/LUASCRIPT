@@ -0,0 +1,224 @@
+# 🔍 YOLO DIAGNOSTIC MODE - Check what's actually broken
+# Before we run fixes, let's see what we're really dealing with
+
+param(
+    [switch]$Verbose = $false,
+    [switch]$Full = $false
+)
+
+Write-Host ""
+Write-Host "╔═════════════════════════════════════════════════════════════════╗" -ForegroundColor Yellow
+Write-Host "║        🔍 LUASCRIPT DIAGNOSTIC MODE - Check Real Issues        ║" -ForegroundColor Yellow
+Write-Host "╚═════════════════════════════════════════════════════════════════╝" -ForegroundColor Yellow
+Write-Host ""
+
+$RepoRoot = (Get-Location).Path
+$DiagnosticLog = Join-Path $RepoRoot "diagnostic-report.txt"
+$HasIssues = $false
+
+function Write-Diagnostic {
+    param([string]$Title, [string]$Result, [string]$Color = "White")
+    Write-Host "[$Title]" -ForegroundColor Cyan -NoNewline
+    Write-Host " $Result" -ForegroundColor $Color
+}
+
+function Check-Command {
+    param([string]$Command, [string]$Description)
+
+    Write-Host ""
+    Write-Host "🔹 Testing: $Description" -ForegroundColor Blue
+    Write-Host "   Command: npm $Command" -ForegroundColor DarkGray
+
+    try {
+        $output = & npm run $Command 2>&1
+        $exitCode = $LASTEXITCODE
+
+        if ($exitCode -eq 0) {
+            Write-Diagnostic "RESULT" "✅ PASS" "Green"
+            if ($Verbose -and $output) {
+                $outputLines = @($output) | Select-Object -Last 3
+                $outputLines | ForEach-Object { Write-Host "          $_" -ForegroundColor DarkGray }
+            }
+        } else {
+            Write-Diagnostic "RESULT" "❌ FAIL (exit code: $exitCode)" "Red"
+            $script:HasIssues = $true
+
+            # Extract error summary
+            $errorLines = @($output) | Select-Object -Last 10
+            $errorLines | ForEach-Object {
+                if ($_ -match "Error|error|fail|FAIL") {
+                    Write-Host "   ERROR: $_" -ForegroundColor Red
+                }
+            }
+        }
+
+        return @{
+            ExitCode = $exitCode
+            Output = $output
+            Passed = ($exitCode -eq 0)
+        }
+    } catch {
+        Write-Diagnostic "RESULT" "❌ EXCEPTION: $($_.Exception.Message)" "Red"
+        $script:HasIssues = $true
+        return @{ ExitCode = -1; Output = $_.Exception.Message; Passed = $false }
+    }
+}
+
+# ═════════════════════════════════════════════════════════════════
+# SECTION 1: BASIC GATES
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host "SECTION 1: QUALITY GATE STATUS" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+
+$harness = Check-Command "harness" "Harness (parser/transpiler)"
+$irVal = Check-Command "ir:validate:all" "IR Validation"
+$parity = Check-Command "test:parity" "Parity (JS↔Lua)"
+$determinism = Check-Command "test:determinism" "Determinism"
+
+# ═════════════════════════════════════════════════════════════════
+# SECTION 2: LINTING DIAGNOSIS
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host ""
+Write-Host "SECTION 2: ESLINT DIAGNOSIS" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+
+Write-Host ""
+Write-Host "🔹 Raw ESLint Version" -ForegroundColor Blue
+$eslintVersion = & npx eslint --version 2>&1
+Write-Host "   $eslintVersion" -ForegroundColor Green
+
+Write-Host ""
+Write-Host "🔹 ESLint Core Tier (src/ir/core/**/*.js)" -ForegroundColor Blue
+Write-Host "   Checking: src/ir/core/**/*.js" -ForegroundColor DarkGray
+
+# Try direct path instead of glob
+$coreFiles = Get-ChildItem -Path "src/ir/core" -Filter "*.js" -Recurse -ErrorAction SilentlyContinue
+Write-Host "   Found: $($coreFiles.Count) files" -ForegroundColor Cyan
+
+if ($coreFiles.Count -gt 0) {
+    $lintResult = & npx eslint @($coreFiles.FullName) --max-warnings 0 2>&1
+    if ($LASTEXITCODE -eq 0) {
+        Write-Host "   ✅ PASS - 0 warnings in core" -ForegroundColor Green
+    } else {
+        $summary = $lintResult | Select-String -Pattern "error|warning" | Select-Object -Last 3
+        Write-Host "   ❌ FAIL - Lint errors detected:" -ForegroundColor Red
+        $summary | ForEach-Object { Write-Host "      $_" -ForegroundColor Yellow }
+        $script:HasIssues = $true
+    }
+} else {
+    Write-Host "   ⚠️ No files found in src/ir/core" -ForegroundColor Yellow
+}
+
+# ═════════════════════════════════════════════════════════════════
+# SECTION 3: COVERAGE DIAGNOSIS
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host ""
+Write-Host "SECTION 3: COVERAGE DIAGNOSIS" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+
+Write-Host ""
+Write-Host "🔹 Coverage Report" -ForegroundColor Blue
+$coverage = & npm run test:coverage 2>&1
+$coverageLine = $coverage | Select-String "Statements|Lines" | Select-Object -First 1
+if ($coverageLine) {
+    Write-Host "   $coverageLine" -ForegroundColor Cyan
+}
+
+# Check if coverage file exists
+$coverageFile = "coverage/coverage-summary.json"
+if (Test-Path $coverageFile) {
+    Write-Host "   Coverage file found: $coverageFile" -ForegroundColor Green
+    try {
+        $covData = Get-Content $coverageFile | ConvertFrom-Json
+        $totalData = $covData.total
+        Write-Host "   Lines: $($totalData.lines.pct)% | Functions: $($totalData.functions.pct)% | Branches: $($totalData.branches.pct)%" -ForegroundColor Cyan
+    } catch {
+        Write-Host "   Could not parse coverage file" -ForegroundColor Yellow
+    }
+} else {
+    Write-Host "   ⚠️ No coverage file found" -ForegroundColor Yellow
+}
+
+# ═════════════════════════════════════════════════════════════════
+# SECTION 4: IR SCHEMA ISSUES
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host ""
+Write-Host "SECTION 4: IR SCHEMA VALIDATION" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+
+Write-Host ""
+Write-Host "🔹 IR Schema Check Details" -ForegroundColor Blue
+$irReport = & npm run ir:validate 2>&1
+$schemaErrors = $irReport | Select-String "Schema validation failed"
+if ($schemaErrors) {
+    Write-Host "   ❌ Schema validation issues found:" -ForegroundColor Red
+    $schemaErrors | Select-Object -First 5 | ForEach-Object {
+        Write-Host "      $_" -ForegroundColor Yellow
+    }
+    Write-Host ""
+    Write-Host "   💡 This means: IR nodes have invalid expression types" -ForegroundColor Cyan
+    $script:HasIssues = $true
+}
+
+# ═════════════════════════════════════════════════════════════════
+# SECTION 5: REAL BLOCKERS
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host ""
+Write-Host "SECTION 5: ROOT CAUSE ANALYSIS" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+
+Write-Host ""
+if ($script:HasIssues) {
+    Write-Host "🚨 REAL ISSUES DETECTED:" -ForegroundColor Red
+    Write-Host ""
+
+    if (-not $irVal.Passed) {
+        Write-Host "1. IR SCHEMA VALIDATION" -ForegroundColor Red
+        Write-Host "   Problem: node_1TT/expression type is invalid" -ForegroundColor Yellow
+        Write-Host "   Action: Run 'npm run ir:validate' and check src/ir/nodes.js" -ForegroundColor Cyan
+        Write-Host ""
+    }
+
+    if (-not $parity.Passed) {
+        Write-Host "2. PARITY FAILURES" -ForegroundColor Red
+        Write-Host "   Problem: JS↔Lua behavior mismatches" -ForegroundColor Yellow
+        Write-Host "   Action: Review failing test case in tests/parity/" -ForegroundColor Cyan
+        Write-Host ""
+    }
+
+    Write-Host "⚠️ AUTO-FIX CANNOT PROCEED - Real code changes needed!" -ForegroundColor Yellow
+} else {
+    Write-Host "✅ All gates appear healthy!" -ForegroundColor Green
+}
+
+# ═════════════════════════════════════════════════════════════════
+# SUMMARY
+# ═════════════════════════════════════════════════════════════════
+
+Write-Host ""
+Write-Host "DIAGNOSTIC SUMMARY" -ForegroundColor Magenta
+Write-Host "════════════════════════════════════════════════════════" -ForegroundColor Magenta
+Write-Host ""
+Write-Host "  Harness:        $(if ($harness.Passed) { '✅' } else { '❌' })" -ForegroundColor $(if ($harness.Passed) { 'Green' } else { 'Red' })
+Write-Host "  IR Validation:  $(if ($irVal.Passed) { '✅' } else { '❌' })" -ForegroundColor $(if ($irVal.Passed) { 'Green' } else { 'Red' })
+Write-Host "  Parity:         $(if ($parity.Passed) { '✅' } else { '❌' })" -ForegroundColor $(if ($parity.Passed) { 'Green' } else { 'Red' })
+Write-Host "  Determinism:    $(if ($determinism.Passed) { '✅' } else { '❌' })" -ForegroundColor $(if ($determinism.Passed) { 'Green' } else { 'Red' })
+Write-Host ""
+
+if ($script:HasIssues) {
+    Write-Host "Next Step:" -ForegroundColor Cyan
+    Write-Host "  1. Pick the biggest blocker above" -ForegroundColor White
+    Write-Host "  2. Read the detailed output" -ForegroundColor White
+    Write-Host "  3. Make targeted code fixes (not auto-fixes)" -ForegroundColor White
+    Write-Host "  4. Re-run diagnostic" -ForegroundColor White
+} else {
+    Write-Host "Next Step:" -ForegroundColor Cyan
+    Write-Host "  All systems nominal - ready to run YOLO mode!" -ForegroundColor Green
+}
+
+Write-Host ""
