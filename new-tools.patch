+#!/usr/bin/env node
+"use strict";
+
+/**
+ * 🔍 INTELLIGENT IR SCHEMA DEBUGGER
+ * Deep dive into IR validation failures to find root causes
+ */
+
+const fs = require("fs");
+const path = require("path");
+const util = require("util");
+
+const { IRBuilder } = require("../src/ir/builder");
+
+console.log("╔═════════════════════════════════════════════════════════════════╗");
+console.log("║        🔍 INTELLIGENT IR SCHEMA DEBUGGER - Deep Dive           ║");
+console.log("╚═════════════════════════════════════════════════════════════════╝");
+console.log("");
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 1: Reproduce the minimal failing case
+// ═══════════════════════════════════════════════════════════════
+
+console.log("STEP 1: Reproducing the minimal IR case that fails validation");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+console.log("🔹 Creating IRBuilder...");
+const b = new IRBuilder({
+  schemaVersion: "1.0.0",
+  metadata: { authoredBy: "schema-validator" }
+});
+
+console.log("🔹 Building nodes:");
+console.log("   - identifier('a')");
+const a = b.identifier("a");
+console.log(`     Result: ${a.id}, type=${a.category}`);
+
+console.log("   - identifier('b')");
+const bParam = b.identifier("b");
+console.log(`     Result: ${bParam.id}, type=${bParam.category}`);
+
+console.log("   - binaryExpression(a.id, '+', b.id)");
+const sum = b.binaryExpression(a.id, "+", bParam.id);
+console.log(`     Result: ${sum.id}, type=${sum.category}`);
+
+console.log("   - returnStatement(sum.id)");
+const ret = b.returnStatement(sum.id);
+console.log(`     Result: ${ret.id}, type=${ret.category}`);
+
+console.log("   - blockStatement([ret.id])");
+const block = b.blockStatement([ret.id]);
+console.log(`     Result: ${block.id}, type=${block.category}`);
+
+console.log("   - functionDeclaration('add', [a.id, b.id], block.id, ...)");
+const fn = b.functionDeclaration("add", [a.id, bParam.id], block.id, { meta: {} });
+console.log(`     Result: ${fn.id}, type=${fn.category}`);
+
+console.log("");
+console.log("🔹 Building IR (validate=false)...");
+const ir = b.build({ validate: false });
+
+console.log("");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 2: Inspect the generated IR structure");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+// Find all nodes
+const allNodeIds = Object.keys(ir.nodes);
+console.log(`Total nodes in IR: ${allNodeIds.length}`);
+console.log("");
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 3: Find problematic node (node_1TT or similar)
+// ═══════════════════════════════════════════════════════════════
+
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 3: Looking for problematic 'expression' fields");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+let foundIssues = false;
+
+for (const nodeId of allNodeIds) {
+  const node = ir.nodes[nodeId];
+
+  // Check if node has 'expression' field
+  if ('expression' in node) {
+    const expr = node.expression;
+    const exprType = typeof expr;
+    const isNull = expr === null;
+    const isString = typeof expr === "string";
+    const isValidNodeRef = isString && /^[^_]+_[T01]+$/.test(expr);
+
+    console.log(`🔍 Node ${nodeId}:`);
+    console.log(`   Type: ${node.type}`);
+    console.log(`   Expression field: ${util.inspect(expr, { depth: 2, colors: true })}`);
+    console.log(`   Expression type: ${exprType}`);
+    console.log(`   Is null: ${isNull}`);
+    console.log(`   Is string: ${isString}`);
+    console.log(`   Is valid NodeRef: ${isValidNodeRef}`);
+
+    if (!isNull && !isValidNodeRef) {
+      console.log(`   ❌ PROBLEM FOUND: expression is ${exprType} but should be NodeRef or null`);
+      foundIssues = true;
+
+      // Deep inspect
+      if (typeof expr === 'object') {
+        console.log(`   Full object:`);
+        console.log(util.inspect(expr, { depth: 5, colors: true }));
+      }
+    } else {
+      console.log(`   ✅ Valid`);
+    }
+    console.log("");
+  }
+}
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 4: Check all fields that should be NodeRef or null
+// ═══════════════════════════════════════════════════════════════
+
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 4: Checking all NodeRef fields across all nodes");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+const nodeRefFields = [
+  'expression', 'left', 'right', 'argument', 'condition',
+  'consequent', 'alternate', 'body', 'callee', 'init',
+  'test', 'update', 'object', 'property', 'superClass'
+];
+
+for (const nodeId of allNodeIds) {
+  const node = ir.nodes[nodeId];
+  let nodeHasIssue = false;
+
+  for (const field of nodeRefFields) {
+    if (field in node) {
+      const value = node[field];
+
+      // Skip arrays and null values (they're fine)
+      if (value === null || Array.isArray(value)) continue;
+
+      // Check if it's a valid NodeRef
+      const isString = typeof value === "string";
+      const isValidNodeRef = isString && /^[^_]+_[T01]+$/.test(value);
+
+      if (!isValidNodeRef) {
+        if (!nodeHasIssue) {
+          console.log(`❌ Node ${nodeId} (${node.type}):`);
+          nodeHasIssue = true;
+          foundIssues = true;
+        }
+        console.log(`   Field '${field}': ${typeof value} = ${util.inspect(value, { depth: 1 })}`);
+      }
+    }
+  }
+
+  if (nodeHasIssue) {
+    console.log("");
+  }
+}
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 5: Run actual schema validation to get exact error
+// ═══════════════════════════════════════════════════════════════
+
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 5: Running actual schema validation");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+const Ajv = require("ajv");
+const addFormats = require("ajv-formats");
+
+const schemaPath = path.join(__dirname, "..", "docs", "canonical_ir.schema.json");
+const schemaText = fs.readFileSync(schemaPath, "utf8");
+const schema = JSON.parse(schemaText);
+
+const ajv = new Ajv({ allErrors: true, strict: false });
+addFormats(ajv);
+const validate = ajv.compile(schema);
+
+const ok = validate(ir);
+
+if (!ok) {
+  console.log("❌ Schema validation FAILED with errors:");
+  console.log("");
+
+  for (const err of validate.errors) {
+    console.log(`Error at ${err.instancePath || "/"}`);
+    console.log(`  Message: ${err.message}`);
+    console.log(`  Schema: ${JSON.stringify(err.params || {})}`);
+
+    // Try to extract the exact node
+    const pathParts = err.instancePath.split('/');
+    if (pathParts[1] === 'nodes' && pathParts[2]) {
+      const nodeId = pathParts[2];
+      const fieldName = pathParts[3];
+
+      console.log(`  Node ID: ${nodeId}`);
+      if (fieldName) {
+        console.log(`  Field: ${fieldName}`);
+        console.log(`  Actual value: ${util.inspect(ir.nodes[nodeId][fieldName], { depth: 3, colors: true })}`);
+      }
+    }
+    console.log("");
+  }
+} else {
+  console.log("✅ Schema validation PASSED!");
+}
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 6: Root cause analysis
+// ═══════════════════════════════════════════════════════════════
+
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 6: Root Cause Analysis");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+if (foundIssues) {
+  console.log("🔥 ROOT CAUSE IDENTIFIED:");
+  console.log("");
+  console.log("The IR builder is creating nodes with invalid field types.");
+  console.log("Fields that should be NodeRef (string matching ^[^_]+_[T01]+$) or null");
+  console.log("are being set to objects or other invalid types.");
+  console.log("");
+  console.log("📍 LIKELY LOCATION:");
+  console.log("  - src/ir/builder.js (node creation methods)");
+  console.log("  - src/ir/nodes.js (Node class toJSON methods)");
+  console.log("");
+  console.log("💡 FIX STRATEGY:");
+  console.log("  1. Check how nodes are being serialized in toJSON()");
+  console.log("  2. Ensure all NodeRef fields store only node.id (string), not node objects");
+  console.log("  3. Add validation in IRNode constructors to catch this early");
+  console.log("");
+} else if (!ok) {
+  console.log("⚠️  Schema validation failed but no obvious issues found in node inspection.");
+  console.log("The error may be in module structure or metadata fields.");
+  console.log("");
+} else {
+  console.log("✅ No issues found! IR is valid.");
+  console.log("");
+}
+
+// ═══════════════════════════════════════════════════════════════
+// STEP 7: Write debug artifacts
+// ═══════════════════════════════════════════════════════════════
+
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("STEP 7: Writing debug artifacts");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+const artifactsDir = path.join(__dirname, "..", "artifacts");
+if (!fs.existsSync(artifactsDir)) {
+  fs.mkdirSync(artifactsDir, { recursive: true });
+}
+
+const debugIRPath = path.join(artifactsDir, "debug-ir-full.json");
+fs.writeFileSync(debugIRPath, JSON.stringify(ir, null, 2));
+console.log(`✅ Full IR written to: ${path.relative(process.cwd(), debugIRPath)}`);
+
+const debugErrorPath = path.join(artifactsDir, "debug-ir-errors.json");
+if (!ok) {
+  fs.writeFileSync(debugErrorPath, JSON.stringify(validate.errors, null, 2));
+  console.log(`✅ Validation errors written to: ${path.relative(process.cwd(), debugErrorPath)}`);
+}
+
+console.log("");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("DEBUGGING COMPLETE");
+console.log("═══════════════════════════════════════════════════════════════");
+console.log("");
+
+process.exit(ok ? 0 : 1);
diff --git a/scripts/yolo-diagnostic.ps1 b/scripts/yolo-diagnostic.ps1
